---
import ThemeProvider from '../components/ThemeProvider.astro'
import '../styles/custom.css'

const title = 'ページが見つかりません | ChuniSupport ガイド'
---

<!doctype html>
<html lang="ja" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Jost:wght@500..700&family=Noto+Sans:wght@400..700&family=Noto+Sans+JP:wght@400..700&display=swap"
		/>
		<title>{title}</title>
		<ThemeProvider />
	</head>
	<body>
		<main class="cs-not-found">
			<section class="cs-not-found__card">
				<div class="cs-not-found__head">
					<span class="cs-not-found__emblem" aria-hidden="true">
						<span class="cs-not-found__logo-mask"></span>
					</span>
					<p class="cs-not-found__status">404</p>
				</div>
				<h1>ページが見つかりません</h1>
				<p class="cs-not-found__message">お探しのページは移動または削除された可能性があります。</p>
				<div class="cs-not-found__actions">
					<a href="/" class="cs-not-found__button">トップへ戻る</a>
				</div>
			</section>
		</main>
	</body>
</html>

<style>
	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		font-family: var(--cs-font-sans);
	}

	.cs-not-found {
		display: grid;
		min-block-size: 100dvh;
		place-items: center;
		padding: 1.5rem;
	}

	.cs-not-found__card {
		width: min(32rem, 100%);
		padding: clamp(1.5rem, 4vw, 2.25rem);
		border: 1px solid var(--cs-color-border);
		border-radius: 0.625rem;
		background-color: var(--cs-color-surface);
	}

	.cs-not-found__head {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.cs-not-found__emblem {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.4375rem;
		border: 1px solid var(--cs-color-action-primary-border);
		background-color: var(--cs-color-action-primary-muted);
	}

	.cs-not-found__logo-mask {
		display: block;
		width: 1.375rem;
		height: 1.375rem;
		background-color: var(--cs-color-action-primary);
		-webkit-mask-image: url('/logo-single.svg');
		mask-image: url('/logo-single.svg');
		-webkit-mask-position: center;
		mask-position: center;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-size: contain;
		mask-size: contain;
	}

	.cs-not-found__status {
		margin: 0;
		color: var(--cs-color-link);
		font-family: var(--cs-font-display);
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	h1 {
		margin: 0 0 0.625rem;
		color: var(--cs-color-text);
		font-size: clamp(1.375rem, 3.5vw, 1.75rem);
		font-weight: 700;
		line-height: 1.3;
		text-wrap: balance;
	}

	.cs-not-found__message {
		margin: 0;
		color: var(--cs-color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.7;
	}

	.cs-not-found__actions {
		margin-top: 1.5rem;
	}

	.cs-not-found__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.5625rem 1.125rem;
		border-radius: 0.375rem;
		background-color: var(--cs-color-action-primary);
		color: var(--cs-color-text-inverse);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 150ms ease;
	}

	.cs-not-found__button:hover {
		background-color: var(--cs-color-action-primary-hover);
	}
</style>
