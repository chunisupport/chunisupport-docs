---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import {
	ANNOUNCEMENT_CATEGORY_LABELS,
	formatAnnouncementDate,
} from '../../lib/announcements'

export async function getStaticPaths() {
	const announcements = await getCollection('announcements')
	return announcements.map((announcement) => ({
		params: { id: announcement.id },
		props: { announcement },
	}))
}

type Props = {
	announcement: CollectionEntry<'announcements'>
}

const { announcement } = Astro.props
const { Content } = await render(announcement)
const publishedDate = announcement.data.publishedAt.toISOString().slice(0, 10)
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: announcement.data.title,
		tableOfContents: false,
		description: announcement.data.summary,
	}}
>
	<div class="announcement-detail-header not-content">
		<div class="announcement-meta">
			<span class={`announcement-category category-${announcement.data.category}`}>
				{ANNOUNCEMENT_CATEGORY_LABELS[announcement.data.category]}
			</span>
			<time datetime={publishedDate}>{formatAnnouncementDate(announcement.data.publishedAt)}</time>
		</div>
		<a href="/announcements/" class="announcement-back-link">
			<svg
				viewBox="0 0 24 24"
				width="15"
				height="15"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="m12 19-7-7 7-7" />
				<path d="M19 12H5" />
			</svg>
			<span>お知らせ一覧へ</span>
		</a>
	</div>

	<div class="sl-markdown-content">
		<Content />
	</div>
</StarlightPage>

<style>
	.announcement-detail-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1rem;
		padding-bottom: 1rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid var(--cs-color-border);
	}

	.announcement-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.625rem;
		color: var(--cs-color-text-muted);
		font-size: 0.8125rem;
	}

	.announcement-category {
		display: inline-flex;
		align-items: center;
		padding: 0.125rem 0.6rem;
		border: 1px solid var(--cs-color-border);
		border-radius: 9999px;
		background-color: var(--cs-color-surface-muted);
		color: var(--cs-color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.category-important {
		border-color: var(--cs-color-danger-border);
		background-color: var(--cs-color-danger-bg);
		color: var(--cs-color-danger);
	}

	.category-update {
		border-color: var(--cs-color-info-border);
		background-color: var(--cs-color-info-bg);
		color: var(--cs-color-info);
	}

	.category-maintenance {
		border-color: var(--cs-color-warning-border);
		background-color: var(--cs-color-warning-bg);
		color: var(--cs-color-warning);
	}

	.announcement-back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--cs-color-link);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 140ms ease;
	}

	.announcement-back-link:hover {
		color: var(--cs-color-link-hover);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
