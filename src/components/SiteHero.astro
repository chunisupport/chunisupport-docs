---
/*
 * Starlight の Hero をオーバーライドし、ChuniSupport 本体のランディング導入カード
 * と統一感のあるサーフェスカード型ヒーローとして描画する。
 * コンテンツ（title / tagline / actions）は各ページの frontmatter をそのまま使用する。
 */
import DraftContentNotice from '@astrojs/starlight/components/DraftContentNotice.astro';
import { Icon } from '@astrojs/starlight/components';

const PAGE_TITLE_ID = '_top';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<section class="cs-hero">
	<div class="cs-hero__inner">
		<div class="cs-hero__copy">
			<div class="cs-hero__brand-row">
				<span class="cs-hero__emblem" aria-hidden="true">
					<span class="cs-hero__logo-mask"></span>
				</span>
				<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			</div>
			{data.draft && <DraftContentNotice />}
			{tagline && <p class="cs-hero__tagline" set:html={tagline} />}
		</div>

		{
			actions.length > 0 && (
				<div class="cs-hero__actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<a
							href={href}
							class:list={['cs-hero__btn', `cs-hero__btn--${variant ?? 'primary'}`, className]}
							{...attrs}
						>
							{icon?.name && icon.name !== 'right-arrow' && icon.name !== 'external' && (
								<Icon name={icon.name} size="1.05rem" />
							)}
							<span>{text}</span>
							{icon?.name && (icon.name === 'right-arrow' || icon.name === 'external') && (
								<Icon name={icon.name} size="1.05rem" />
							)}
							{icon?.html && <Fragment set:html={icon.html} />}
						</a>
					))}
				</div>
			)
		}
	</div>

	<div class="cs-hero__watermark" aria-hidden="true">
		<span class="cs-hero__watermark-mask"></span>
	</div>
</section>

<style>
	.cs-hero {
		position: relative;
		overflow: hidden;
		padding: clamp(1.5rem, 3.5vw, 2.5rem);
		border: 1px solid var(--cs-color-border);
		border-radius: 0.625rem;
		background-color: var(--cs-color-surface);
		background-image: linear-gradient(
			135deg,
			var(--cs-color-surface) 58%,
			var(--cs-color-action-primary-muted) 100%
		);
	}

	.cs-hero__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 44rem;
	}

	.cs-hero__copy {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.cs-hero__brand-row {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.cs-hero__emblem {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.5rem;
		border: 1px solid var(--cs-color-action-primary-border);
		background-color: var(--cs-color-action-primary-muted);
		flex-shrink: 0;
	}

	.cs-hero__logo-mask {
		display: block;
		width: 1.75rem;
		height: 1.75rem;
		background-color: var(--cs-color-action-primary);
		-webkit-mask-image: url('/logo-single.svg');
		mask-image: url('/logo-single.svg');
		-webkit-mask-position: center;
		mask-position: center;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-size: contain;
		mask-size: contain;
	}

	.cs-hero h1 {
		margin: 0;
		font-family: var(--cs-font-sans);
		font-size: clamp(1.5rem, 3.2vw, 2.125rem);
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.015em;
		color: var(--cs-color-text);
		text-wrap: balance;
	}

	.cs-hero__tagline {
		margin: 0;
		font-size: clamp(0.9375rem, 1.4vw, 1.0625rem);
		line-height: 1.7;
		color: var(--cs-color-text-muted);
	}

	.cs-hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	@media (max-width: 30rem) {
		.cs-hero__actions {
			flex-direction: column;
			align-items: stretch;
		}
	}

	.cs-hero__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-height: 2.5rem;
		padding: 0.5625rem 1.125rem;
		border: 1px solid transparent;
		border-radius: 0.375rem;
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		transition:
			background-color 150ms ease,
			border-color 150ms ease,
			color 150ms ease;
	}

	.cs-hero__btn--primary {
		background-color: var(--cs-color-action-primary);
		border-color: var(--cs-color-action-primary);
		color: var(--cs-color-text-inverse);
	}

	.cs-hero__btn--primary:hover {
		background-color: var(--cs-color-action-primary-hover);
		border-color: var(--cs-color-action-primary-hover);
		color: var(--cs-color-text-inverse);
	}

	.cs-hero__btn--secondary {
		background-color: var(--cs-color-surface);
		border-color: var(--cs-color-border-strong);
		color: var(--cs-color-text);
	}

	.cs-hero__btn--secondary:hover {
		background-color: var(--cs-color-surface-muted);
		border-color: var(--cs-color-border-strong);
		color: var(--cs-color-text);
	}

	.cs-hero__btn--minimal {
		background-color: transparent;
		border-color: var(--cs-color-border);
		color: var(--cs-color-link);
	}

	.cs-hero__btn--minimal:hover {
		background-color: var(--cs-color-action-primary-muted);
		border-color: var(--cs-color-action-primary-border);
		color: var(--cs-color-link-hover);
	}

	.cs-hero__watermark {
		position: absolute;
		inset-block-end: -2.25rem;
		inset-inline-end: -1.5rem;
		width: 14rem;
		height: 14rem;
		pointer-events: none;
		opacity: 0.08;
		display: none;
	}

	@media (min-width: 48rem) {
		.cs-hero__watermark {
			display: block;
		}
	}

	.cs-hero__watermark-mask {
		display: block;
		width: 100%;
		height: 100%;
		background-color: var(--cs-color-action-primary);
		-webkit-mask-image: url('/logo-single.svg');
		mask-image: url('/logo-single.svg');
		-webkit-mask-position: center;
		mask-position: center;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-size: contain;
		mask-size: contain;
	}
</style>
