---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro'
import type { StarlightRouteData } from '@astrojs/starlight/route-data'

type SidebarEntry = StarlightRouteData['sidebar'][number]
type SidebarLink = NonNullable<StarlightRouteData['pagination']['prev']>

const route = Astro.locals.starlightRoute
const section = route.id.split('/')[0]
const sectionRoot = `/${section}/`

/** 現在のセクション内を指すサイドバー項目か判定する。 */
const isSectionEntry = (entry: SidebarEntry): boolean => {
  if (entry.type === 'link') {
    return entry.href === sectionRoot || entry.href.startsWith(sectionRoot)
  }

  return entry.entries.some(isSectionEntry)
}

/** 前後ページリンクが別セクションへ移動しないようにする。 */
const keepSectionLink = (link: SidebarLink | undefined): SidebarLink | undefined => {
  if (!link) return undefined
  return link.href === sectionRoot || link.href.startsWith(sectionRoot) ? link : undefined
}

route.sidebar = route.sidebar.filter(isSectionEntry)
route.pagination = {
  prev: keepSectionLink(route.pagination.prev),
  next: keepSectionLink(route.pagination.next),
}
---

<DefaultSidebar />
