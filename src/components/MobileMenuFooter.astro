---
/*
 * Starlight の MobileMenuFooter をオーバーライドし、モバイルドロワー下部から
 * 他セクションや ChuniSupport 本体へ移動できる導線と、インライン外観設定を提供する。
 */
import ThemeSelect from './ThemeSelect.astro';
import { PUBLIC_APP_URL } from 'astro:env/server';

const pathname = Astro.url.pathname;

const navLinks = [
	{ href: '/', label: 'トップ', exact: true },
	{ href: '/help/', label: 'ヘルプ', exact: false },
	{ href: '/announcements/', label: 'お知らせ', exact: false },
	{ href: '/api/', label: 'APIドキュメント', exact: false },
] as const;

const isActive = (href: string, exact: boolean) =>
	exact ? pathname === '/' : pathname === href || pathname.startsWith(href);
---

<div class="cs-mobile-footer">
	<nav class="cs-mobile-footer__nav" aria-label="サイトナビゲーション">
		<p class="cs-mobile-footer__heading">セクション</p>
		<ul>
			{
				navLinks.map(({ href, label, exact }) => (
					<li>
						<a href={href} aria-current={pathname === href ? 'page' : isActive(href, exact) ? 'true' : undefined}>
							{label}
						</a>
					</li>
				))
			}
			<li>
				<a href={PUBLIC_APP_URL} target="_blank" rel="noopener noreferrer" class="cs-mobile-footer__external">
					<span>ChuniSupportを開く</span>
					<svg
						viewBox="0 0 24 24"
						width="14"
						height="14"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M15 3h6v6" />
						<path d="M10 14 21 3" />
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
					</svg>
				</a>
			</li>
		</ul>
	</nav>

	<div class="cs-mobile-footer__appearance">
		<p class="cs-mobile-footer__heading">外観</p>
		<ThemeSelect inline />
	</div>
</div>

<style>
	.cs-mobile-footer {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-top: 1.25rem;
		padding-top: 1.25rem;
		padding-bottom: 1.5rem;
		border-top: 1px solid var(--cs-color-border);
	}

	.cs-mobile-footer__heading {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--cs-color-text-muted);
	}

	.cs-mobile-footer__nav ul {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cs-mobile-footer__nav a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0.625rem;
		border-radius: 0.375rem;
		color: var(--cs-color-nav-text);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			background-color 140ms ease,
			color 140ms ease;
	}

	.cs-mobile-footer__nav a:hover {
		background-color: var(--cs-color-surface-hover);
		color: var(--cs-color-text);
	}

	.cs-mobile-footer__nav a[aria-current] {
		background-color: var(--cs-color-action-primary-muted);
		color: var(--cs-color-link);
	}

	.cs-mobile-footer__external {
		color: var(--cs-color-text-muted);
	}
</style>
