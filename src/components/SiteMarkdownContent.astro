---
/*
 * Starlight の MarkdownContent をオーバーライドする。
 * 本番ビルドでは astro.config.mjs のインテグレーションが静的 HTML へ
 * data-cs-table / data-label を事前付与するため、クライアントスクリプトは
 * dev サーバー実行時などのフォールバックとしてのみ動作する。
 */
import DefaultMarkdownContent from '@astrojs/starlight/components/MarkdownContent.astro';
---

<DefaultMarkdownContent>
	<slot />
</DefaultMarkdownContent>

<script>
	import { resolveTableLayout } from '../lib/responsiveTables';

	for (const table of document.querySelectorAll<HTMLTableElement>(
		'.sl-markdown-content table:not([data-cs-table])'
	)) {
		if (table.closest('.not-content')) continue;
		const headers = Array.from(table.querySelectorAll('thead tr:first-child th')).map(
			(th) => th.textContent?.replace(/\s+/g, ' ').trim() ?? ''
		);
		if (headers.length === 0) continue;

		table.dataset.csTable = resolveTableLayout(headers);
		for (const row of table.querySelectorAll('tbody tr')) {
			const cells = row.querySelectorAll('td');
			cells.forEach((cell, index) => {
				const label = headers[index];
				if (label && !cell.hasAttribute('data-label')) {
					cell.dataset.label = label;
				}
			});
		}
	}
</script>
