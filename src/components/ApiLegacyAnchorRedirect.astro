---
/*
 * APIドキュメントは以前 /api/ の 1 ページにまとまっていたため、
 * 旧URL（/api/#get-v1songs など）を分割後の各ページへ転送する。
 * 見出しから対応表を組み立てるので、エンドポイント追加時の保守は不要。
 */
import { getCollection, render } from 'astro:content'

const docs = await getCollection('docs')
const pages = docs.filter((entry) => entry.id.startsWith('api/') && entry.id !== 'api/index')

const anchors: Record<string, string> = {
  'chunirec互換api-compatchunirec20': '/api/compat-chunirec/',
  'reiwa互換api-compatreiwa1': '/api/compat-reiwa/',
}
for (const page of pages) {
  const { headings } = await render(page)
  for (const { slug } of headings) {
    anchors[slug] ??= `/${page.id}/#${slug}`
  }
}

// script 要素の本文として埋め込む。< をエスケープして </script> を防ぐ。
const anchorsJson = JSON.stringify(anchors).replaceAll('<', '\\u003c')
---

<script type="application/json" id="api-legacy-anchors" is:inline set:html={anchorsJson} />
<script>
  import { legacyAnchorRedirectTarget } from '../lib/legacyAnchorRedirect'

  const raw = document.getElementById('api-legacy-anchors')?.textContent ?? '{}'
  const anchors = JSON.parse(raw) as Record<string, unknown>
  // 概要ページに残っている見出し（#認証 など）はそのまま表示する
  const target = legacyAnchorRedirectTarget(anchors, location.hash, (id) =>
    document.getElementById(id) !== null,
  )
  if (target) location.replace(target)
</script>
