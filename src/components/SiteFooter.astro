---
/*
 * Starlight の Footer をオーバーライドし、既定のフッター（前後ページ等）の下に
 * 利用規約・プライバシーポリシーなどのサイト共通リンクを表示する。
 */
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';

const links = [
	{ href: '/announcements/', label: 'お知らせ' },
	{ href: '/legal/terms/', label: '利用規約' },
	{ href: '/legal/privacy/', label: 'プライバシーポリシー' },
];
---

<DefaultFooter />

<footer class="cs-site-footer">
	<nav aria-label="サイト情報">
		<ul>
			{
				links.map(({ href, label }) => (
					<li>
						<a href={href}>{label}</a>
					</li>
				))
			}
		</ul>
	</nav>
	<p class="cs-site-footer__brand">ChuniSupport ガイド</p>
</footer>

<style>
	.cs-site-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--cs-color-border);
		font-size: 0.8125rem;
	}

	.cs-site-footer ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cs-site-footer a {
		color: var(--cs-color-text-muted);
		text-decoration: none;
		font-weight: 500;
		transition: color 140ms ease;
	}

	.cs-site-footer a:hover {
		color: var(--cs-color-link);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.cs-site-footer__brand {
		margin: 0;
		color: var(--cs-color-text-subtle);
		font-size: 0.75rem;
		font-weight: 600;
	}
</style>
